platform :ios, '18.2'

target 'iosApp' do
  use_frameworks!
  pod 'shared', :path => '../shared'
end

# Xcode 27 no longer includes simulator runtimes below iOS 15. LunarSwift 1.1.8
# still declares iOS 11, so raise only outdated Pod targets at integration time.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      deployment_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0' if deployment_target < 15.0
    end
  end
end
